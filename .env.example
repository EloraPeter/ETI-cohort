# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only, never expose to the client.
# Used by the admin dashboard and the registration API route.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of emails allowed into /admin
NEXT_PUBLIC_ADMIN_EMAILS=you@eloratechinstitute.com

NEXT_PUBLIC_SITE_URL=https://eloratechinstitute.com
