# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only, never expose to the client.
# Used by the admin dashboard, registration API, and all payment routes.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of emails allowed into /admin
NEXT_PUBLIC_ADMIN_EMAILS=you@eloratechinstitute.com

# Used to build absolute callback/onboarding/email links — must match
# your deployed domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://cohort.eloratechinstitute.com

# Paystack (Settings -> API Keys & Webhooks). Use the LIVE secret key
# in production, the TEST secret key for local/staging.
PAYSTACK_SECRET_KEY=

# Resend (resend.com) — optional. Without it, enrollment confirmation
# emails are logged to the server console instead of sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Elora Tech Institute <admissions@eloratechinstitute.com>"
